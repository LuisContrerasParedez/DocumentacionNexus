index 0000000..d7e7786
--- /dev/null
+++ b/Backend/BancoERP.UnitTests/InternalApiAuthorizationTests.cs
@@ -0,0 +1,92 @@
+using BancoERP.Domain.Constants;
+using BancoERP.InternalAPI.Authorization;
+using BancoERP.InternalAPI.Controllers;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Mvc.Routing;
+using System.Reflection;
+
+namespace BancoERP.UnitTests;
+
+// Regresión de BUG-NEX-01: ningún endpoint de la InternalAPI puede quedar accesible sin token por omisión.
+public class InternalApiAuthorizationTests
+{
+    private static readonly HashSet<string> EndpointsPublicos =
+    [
+        "PingController.Get",
+        "AuthController.Login",
+        "AuthController.RefreshToken",
+        "AuthController.SolicitarRecuperacionPassword",
+        "AuthController.RestablecerPassword"
+    ];
+
+    [Fact]
+    public void InternalApi_TodosLosEndpoints_RequierenAutenticacionSalvoLosPublicosDeclarados()
+    {
+        var expuestos = ObtenerAcciones()
+            .Where(a => !RequiereAutenticacion(a.Controlador, a.Accion))
+            .Select(a => $"{a.Controlador.Name}.{a.Accion.Name}")
+            .Where(nombre => !EndpointsPublicos.Contains(nombre))
+            .ToArray();
+
+        Assert.Empty(expuestos);
+    }
+
+    [Fact]
+    public void AchBancosController_ExigeAutenticacionEnTodasSusAcciones()
+    {
+        Assert.NotNull(typeof(AchBancosController).GetCustomAttribute<AuthorizeAttribute>());
+        Assert.All(
+            ObtenerAcciones().Where(a => a.Controlador == typeof(AchBancosController)),
+            a => Assert.Null(a.Accion.GetCustomAttribute<AllowAnonymousAttribute>()));
+    }
+
+    [Theory]
+    [InlineData(nameof(AchBancosController.Listar), PermisosSeguridad.AchBancosListar)]
+    [InlineData(nameof(AchBancosController.Obtener), PermisosSeguridad.AchBancosVer)]
+    [InlineData(nameof(AchBancosController.Crear), PermisosSeguridad.AchBancosCrear)]
+    [InlineData(nameof(AchBancosController.Actualizar), PermisosSeguridad.AchBancosEditar)]
+    [InlineData(nameof(AchBancosController.CambiarEstado), PermisosSeguridad.AchBancosCambiarEstado)]
+    [InlineData(nameof(AchBancosController.Eliminar), PermisosSeguridad.AchBancosEliminar)]
+    public void AchBancosController_AccionesAdministrativas_ExigenPermisoAch(string accion, string permiso)
+    {
+        var atributo = typeof(AchBancosController).GetMethod(accion)!.GetCustomAttribute<RequirePermissionAttribute>();
+
+        Assert.NotNull(atributo);
+        Assert.Equal(PermissionPolicyProvider.PolicyPrefix + permiso, atributo.Policy);
+    }
+
+    [Fact]
+    public void AchBancosController_ListarActivos_SoloExigeSesionParaCajerosYClientes()
+    {
+        var accion = typeof(AchBancosController).GetMethod(nameof(AchBancosController.ListarActivos))!;
+
+        Assert.Null(accion.GetCustomAttribute<RequirePermissionAttribute>());
+        Assert.True(RequiereAutenticacion(typeof(AchBancosController), accion));
+    }
+
+    [Fact]
+    public void AchTransferenciasController_ExigeAutenticacion()
+    {
+        Assert.NotNull(typeof(AchTransferenciasController).GetCustomAttribute<AuthorizeAttribute>());
+    }
+
+    private static IEnumerable<(Type Controlador, MethodInfo Accion)> ObtenerAcciones() =>
+        typeof(AchBancosController).Assembly.GetTypes()
+            .Where(t => t is { IsClass: true, IsAbstract: false } && typeof(ControllerBase).IsAssignableFrom(t))
+            .SelectMany(t => t.GetMethods(BindingFlags.Public | BindingFlags.Instance | BindingFlags.DeclaredOnly)
+                .Where(m => m.GetCustomAttributes<HttpMethodAttribute>().Any())
+                .Select(m => (t, m)));
+
+    private static bool RequiereAutenticacion(Type controlador, MethodInfo accion)
+    {
+        if (accion.GetCustomAttribute<AllowAnonymousAttribute>() is not null ||
+            controlador.GetCustomAttribute<AllowAnonymousAttribute>() is not null)
+        {
+            return false;
+        }
+
+        return accion.GetCustomAttributes<AuthorizeAttribute>(inherit: true).Any() ||
+               controlador.GetCustomAttributes<AuthorizeAttribute>(inherit: true).Any();
+    }
+}
