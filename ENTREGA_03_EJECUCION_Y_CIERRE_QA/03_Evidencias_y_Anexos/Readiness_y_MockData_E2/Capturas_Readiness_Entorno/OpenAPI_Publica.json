{
  "openapi": "3.0.4",
  "info": {
    "title": "BancoERP.PublicAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/external/ach/cuentas/search/{numeroCuenta}": {
      "get": {
        "tags": [
          "ExternalAch"
        ],
        "summary": "Busca una cuenta destino en Banco ERP para validar si puede recibir ACH.",
        "description": "Ejemplo de response exitosa:\n            \n    {\n      \"status\": true,\n      \"message\": \"Cuenta encontrada.\",\n      \"data\": {\n        \"numeroCuenta\": \"0000000000000\",\n        \"nombreTitular\": \"Nombre del cliente\",\n        \"moneda\": \"Q\",\n        \"estado\": \"ACTIVA\",\n        \"puedeRecibirTransferencias\": true\n      }\n    }",
        "parameters": [
          {
            "name": "numeroCuenta",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchCuentaResponsePublicApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchCuentaResponsePublicApiResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchCuentaResponsePublicApiResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchCuentaResponsePublicApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/external/ach/transferencias": {
      "post": {
        "tags": [
          "ExternalAch"
        ],
        "summary": "Registra y acredita una transferencia ACH entrante de un banco externo.",
        "description": "Ejemplo de request:\n            \n    POST /api/external/ach/transferencias\n    {\n      \"codigo_confirmacion\": \"TRX-EXTERNO-20260505-000001\",\n      \"banco_externo\": \"DERBANCKS\",\n      \"cuenta_externa\": \"1234567890\",\n      \"numeroCuentaDestino\": \"0000000000000\",\n      \"monto\": 500.00,\n      \"moneda\": \"Q\",\n      \"referencia\": \"Transferencia ACH entrante\",\n      \"tipo\": \"entrante\"\n    }\n            \nEjemplo de response exitosa:\n            \n    {\n      \"status\": true,\n      \"message\": \"Transferencia recibida correctamente.\",\n      \"data\": {\n        \"codigoConfirmacion\": \"TRX-EXTERNO-20260505-000001\",\n        \"numeroCuentaDestino\": \"0000000000000\",\n        \"monto\": 500.00,\n        \"moneda\": \"Q\",\n        \"estado\": \"APROBADA\",\n        \"fechaProcesamiento\": \"2026-05-05T20:00:00Z\"\n      }\n    }\n            \nEjemplo de response duplicada:\n            \n    {\n      \"status\": false,\n      \"message\": \"La transferencia ya fue procesada.\",\n      \"errors\": {\n        \"codigo_confirmacion\": [\n          \"El codigo de confirmacion ya existe.\"\n        ]\n      }\n    }",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalAchTransferCreateRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalAchTransferCreateRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalAchTransferCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchTransferResponsePublicApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchTransferResponsePublicApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchTransferResponsePublicApiResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchTransferResponsePublicApiResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchTransferResponsePublicApiResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAchTransferResponsePublicApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/external/auth/login": {
      "post": {
        "tags": [
          "ExternalAuth"
        ],
        "summary": "Autentica un banco externo y genera un JWT limitado a operaciones ACH publicas.",
        "description": "Ejemplo de request:\n            \n    POST /api/external/auth/login\n    {\n      \"email\": \"bancoexterno@nexus.com\",\n      \"password\": \"******\"\n    }\n            \nEjemplo de response:\n            \n    {\n      \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n      \"expiresAt\": \"2026-05-05T20:00:00Z\",\n      \"tokenType\": \"Bearer\"\n    }",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalBankLoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalBankLoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalBankLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalBankLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Home": {
      "get": {
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
